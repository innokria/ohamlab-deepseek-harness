{
  "name": "@ohamlab/harness-voice",
  "version": "0.1.0",
  "description": "OhamLab browser voice input and spoken replies for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {"types": "./lib/types/index.d.ts", "default": "./lib/index.js"},
    "./client": {"types": "./lib/types/client/index.d.ts", "default": "./lib/client.js"},
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-layout"],
      "platform": "web"
    }
  },
  "scripts": {"build": "node build.mjs", "check": "node --check src/client.js"},
  "devDependencies": {"esbuild": "^0.25.12"},
  "license": "MIT"
}
